        {
            "name": "5. Interventions",
            "item": [
                {
                    "name": "TECHNICIEN cree un ticket d'intervention",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "pm.collectionVariables.set('id_intervention', jsonData.idIntervention);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token_technicien}}"
                            }
                        ],
                        "url": "{{base_url}}/api/interventions",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"idPanne\": {{id_panne}},\n  \"idTechnicien\": {{id_utilisateur_technicien}},\n  \"typeIntervention\": \"EN_PRESENTIEL\"\n}"
                        }
                    }
                },
                {
                    "name": "TECHNICIEN renseigne diagnostic",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token_technicien}}"
                            }
                        ],
                        "url": "{{base_url}}/api/interventions/{{id_intervention}}/diagnostic?diagnostic=Alimentation defectueuse&solution=Remplacement du bloc alimentation&piecesRemplacees=Bloc alimentation 500W"
                    }
                },
                {
                    "name": "TECHNICIEN renseigne le resultat",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token_technicien}}"
                            }
                        ],
                        "url": "{{base_url}}/api/interventions/{{id_intervention}}/resultat?resultat=REPARATION"
                    }
                },
                {
                    "name": "TECHNICIEN redige le rapport",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token_technicien}}"
                            }
                        ],
                        "url": "{{base_url}}/api/interventions/{{id_intervention}}/rapport?rapport=Bloc alimentation remplace, poste operationnel"
                    }
                },
                {
                    "name": "DSI consulte les interventions en attente",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token_dsi}}"
                            }
                        ],
                        "url": "{{base_url}}/api/interventions/en-attente-dsi"
                    }
                },
                {
                    "name": "DSI valide l'intervention",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token_dsi}}"
                            }
