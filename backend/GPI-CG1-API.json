                    "name": "REFUS - TECHNICIEN valide lui-meme (attendu 403)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token_technicien}}"
                            }
                        ],
                        "url": "{{base_url}}/api/interventions/{{id_intervention}}/valider"
                    }
                }
            ]
