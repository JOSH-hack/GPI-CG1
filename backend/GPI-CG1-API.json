    "item": [
        {
            "name": "0. Setup - Extract User IDs",
            "item": [
                {
                    "name": "Get All Users (Admin)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "jsonData.forEach(function(user) {",
                                    "    if (user.role === 'ADMIN_INFO') {",
                                    "        pm.collectionVariables.set('id_utilisateur_admin', user.idUtilisateur);",
                                    "    }",
                                    "    if (user.role === 'TECHNICIEN') {",
                                    "        pm.collectionVariables.set('id_utilisateur_technicien', user.idUtilisateur);",
                                    "    }",
                                    "    if (user.role === 'AGENT') {",
                                    "        pm.collectionVariables.set('id_utilisateur_agent', user.idUtilisateur);",
                                    "    }",
                                    "    if (user.role === 'RESPONSABLE_DSI') {",
                                    "        pm.collectionVariables.set('id_utilisateur_dsi', user.idUtilisateur);",
                                    "    }",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token_admin}}"
                            }
                        ],
                        "url": "{{base_url}}/api/utilisateurs"
                    }
                }
            ]
        },
